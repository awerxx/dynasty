@page "/expenses"
@using System.Globalization
@inject IQueryHandler<GetMonthlyExpensesQuery, IReadOnlyList<MonthlyExpenseSummary>> MonthlyExpenses

<PageTitle>Expenses</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Expenses</MudText>
<MudText Typo="Typo.body1" Class="mb-4">What was spent each month in @year.</MudText>

<MudTable Items="@summaries"
          Loading="@(summaries is null)"
          Hover="true"
          Striped="true"
          Elevation="1"
          Dense="true">
    <HeaderContent>
        <MudTh>Month</MudTh>
        <MudTh Style="text-align:right">Expenses</MudTh>
        <MudTh Style="text-align:right">Total</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Month">@MonthName(context.Month)</MudTd>
        <MudTd DataLabel="Expenses" Style="text-align:right">@context.ExpenseCount</MudTd>
        <MudTd DataLabel="Total" Style="text-align:right">@Money(context.Total)</MudTd>
    </RowTemplate>
    <FooterContent>
        <MudTh>Year total</MudTh>
        <MudTh Style="text-align:right">@summaries?.Sum(summary => summary.ExpenseCount)</MudTh>
        <MudTh Style="text-align:right">@Money(summaries?.Sum(summary => summary.Total) ?? 0m)</MudTh>
    </FooterContent>
    <NoRecordsContent>
        <MudText>No expenses recorded for @year.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private readonly int year = DateTime.Today.Year;

    private IReadOnlyList<MonthlyExpenseSummary>? summaries;

    protected override async Task OnInitializedAsync()
    {
        summaries = await MonthlyExpenses.Handle(new GetMonthlyExpensesQuery(year), CancellationToken.None);
    }

    private static string MonthName(int month)
    {
        return CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month);
    }

    private static string Money(decimal amount)
    {
        return amount.ToString("C", CultureInfo.CurrentCulture);
    }

}
