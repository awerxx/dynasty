@using Dynasty.Carrington.Blake.Web.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<MudNavMenu>
    <MudNavLink Href="Account/Manage" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Person">Profile</MudNavLink>
    <MudNavLink Href="Account/Manage/Email" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Email">Email</MudNavLink>
    <MudNavLink Href="Account/Manage/ChangePassword" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Password">Password</MudNavLink>
    @if (hasExternalLogins)
    {
        <MudNavLink Href="Account/Manage/ExternalLogins" Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.Link">External logins</MudNavLink>
    }
    <MudNavLink Href="Account/Manage/TwoFactorAuthentication" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Security">Two-factor authentication</MudNavLink>
    <MudNavLink Href="Account/Manage/Passkeys" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Key">Passkeys</MudNavLink>
    <MudNavLink Href="Account/Manage/PersonalData" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.ManageAccounts">Personal data</MudNavLink>
</MudNavMenu>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }

}
