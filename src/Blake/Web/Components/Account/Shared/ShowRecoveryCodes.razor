<StatusMessage Message="@StatusMessage"/>

<MudText Typo="Typo.h5" GutterBottom="true">Recovery codes</MudText>

<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" role="alert">
    <MudText Typo="Typo.body1"><strong>Put these codes in a safe place.</strong></MudText>
    <MudText Typo="Typo.body2">
        If you lose your device and don't have the recovery codes you will lose access to your account.
    </MudText>
</MudAlert>

<MudPaper Class="pa-4" Elevation="1">
    <MudGrid Spacing="2">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <MudItem xs="12" sm="6">
                <code class="recovery-code">@recoveryCode</code>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public string[] RecoveryCodes { get; set; } = [];

    [Parameter] public string? StatusMessage { get; set; }
}
