@inherits LayoutComponentBase

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" aria-label="Navigation menu"/>
        <MudText Typo="Typo.h6" Class="ml-2">Dynasty.Carrington.Blake.Web</MudText>
        <MudSpacer/>
        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Inherit"
                       Href="https://learn.microsoft.com/aspnet/core/" Target="_blank" Title="About"/>
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
        <NavMenu/>
    </MudDrawer>

    <MudMainContent Class="pa-4">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool drawerOpen = true;

    private void ToggleDrawer() => drawerOpen = !drawerOpen;
}
